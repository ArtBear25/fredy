{
  "schema_version": 1,
  "id": "gewobag",
  "name": "Gewobag Bewerbung",
  "provider": "gewobag",
  "version": 1,
  "enabled": false,
  "lifecycle": "recorded",
  "allowed_domains": ["www.gewobag.de", "app.wohnungshelden.de"],
  "rules": {"mode": "all", "conditions": [], "groups": []},
  "steps": [
    {"id":"open-listing","action":"navigate","binding":{"source":"listing","key":"url"}},
    {"id":"cookie-preferences","action":"click","target":{"label":"Speichern wie ausgewählt","tag":"button","candidates":[{"strategy":"id","value":"CookieBoxSaveButton","score":100}]},"optional":true,"timeout_seconds":2,"non_submitting":true},
    {"id":"open-application","action":"click","target":{"label":"Anfrage senden","tag":"button","candidates":[{"strategy":"xpath","value":"(//button[@data-tab='rental-contact'])[1]","score":100}]},"non_submitting":true},
    {"id":"application-frame","action":"switch_frame","target":{"label":"Wohnungshelden Bewerbungsformular","tag":"iframe","candidates":[{"strategy":"id","value":"contact-iframe","score":100}]}},
    {"id":"salutation","action":"autocomplete","target":{"label":"Anrede","tag":"input","candidates":[{"strategy":"id","value":"salutation","score":100}]},"binding":{"source":"literal","value":"Keine"}},
    {"id":"first-name","action":"fill","target":{"label":"Vorname","tag":"input","candidates":[{"strategy":"id","value":"firstName","score":100}]},"binding":{"source":"profile","key":"first_name"}},
    {"id":"last-name","action":"fill","target":{"label":"Nachname","tag":"input","candidates":[{"strategy":"id","value":"lastName","score":100}]},"binding":{"source":"profile","key":"last_name"}},
    {"id":"email","action":"fill","target":{"label":"E-Mail","tag":"input","candidates":[{"strategy":"id","value":"email","score":100}]},"binding":{"source":"profile","key":"email"}},
    {"id":"phone","action":"fill","target":{"label":"Telefonnummer","tag":"input","candidates":[{"strategy":"id","value":"phone-number","score":100}]},"binding":{"source":"profile","key":"phone"}},
    {"id":"street","action":"fill","target":{"label":"Straße","tag":"input","candidates":[{"strategy":"id","value":"street","score":100}]},"binding":{"source":"profile","key":"street","format":"street_name"}},
    {"id":"house-number","action":"fill","target":{"label":"Nr.","tag":"input","candidates":[{"strategy":"id","value":"house-number","score":100}]},"binding":{"source":"profile","key":"street","format":"house_number"}},
    {"id":"postcode","action":"fill","target":{"label":"PLZ","tag":"input","candidates":[{"strategy":"id","value":"zip-code","score":100}]},"binding":{"source":"profile","key":"postcode"}},
    {"id":"city","action":"fill","target":{"label":"Ort","tag":"input","candidates":[{"strategy":"id","value":"city","score":100}]},"binding":{"source":"profile","key":"city"}},
    {"id":"household-size","action":"fill","target":{"label":"Gesamtzahl der einziehenden Personen","tag":"input","candidates":[{"strategy":"css","value":"input[id*='gewobag_gesamtzahl_der_einziehenden_personen']","score":100}]},"binding":{"source":"profile","key":"household_size"}},
    {"id":"wbs-yes","action":"check","target":{"label":"WBS vorhanden: Ja","tag":"input","candidates":[{"strategy":"css","value":"input[id*='wbs_available'][id$='-Ja']","score":100}]},"binding":{"source":"literal","value":true},"condition":{"mode":"all","conditions":[{"field":"profile.has_wbs","operator":"eq","value":true}]},"optional_target":true,"timeout_seconds":2},
    {"id":"wbs-no","action":"check","target":{"label":"WBS vorhanden: Nein","tag":"input","candidates":[{"strategy":"css","value":"input[id*='wbs_available'][id$='-Nein']","score":100}]},"binding":{"source":"literal","value":true},"condition":{"mode":"all","conditions":[{"field":"profile.has_wbs","operator":"eq","value":false}]},"optional_target":true,"timeout_seconds":2},
    {"id":"wbs-valid-until","action":"fill","target":{"label":"Gültigkeit des WBS","tag":"input","candidates":[{"strategy":"css","value":"input[id*='wbs_valid_until']","score":100}]},"binding":{"source":"profile","key":"wbs_valid_until","format":"date_dd_mm_yyyy"},"condition":{"mode":"all","conditions":[{"field":"profile.has_wbs","operator":"eq","value":true}]},"optional_target":true,"timeout_seconds":2},
    {"id":"wbs-type","action":"autocomplete","target":{"label":"Art / Bezeichnung des WBS","tag":"input","candidates":[{"strategy":"css","value":"input[id*='gewobag_art_bezeichnung_des_wbs']","score":100}]},"binding":{"source":"profile","key":"wbs_type","format":"wbs_label"},"condition":{"mode":"all","conditions":[{"field":"profile.has_wbs","operator":"eq","value":true}]},"optional_target":true,"timeout_seconds":2},
    {"id":"wbs-rooms","action":"autocomplete","target":{"label":"Anzahl Räume/Zimmer im WBS","tag":"input","candidates":[{"strategy":"css","value":"input[id*='wbs_max_number_rooms']","score":100}]},"binding":{"source":"profile","key":"wbs_rooms","format":"wbs_rooms_label"},"condition":{"mode":"all","conditions":[{"field":"profile.has_wbs","operator":"eq","value":true}]},"optional_target":true,"timeout_seconds":2},
    {"id":"for-self","action":"autocomplete","target":{"label":"Wohnungsanfrage für","tag":"input","candidates":[{"strategy":"css","value":"input[id*='gewobag_fuer_wen_wird_die_wohnungsanfrage_gestellt']","score":100}]},"binding":{"source":"literal","value":"Für mich selbst"}},
    {"id":"mobile-phone","action":"fill","target":{"label":"Mobilfunknummer","tag":"input","candidates":[{"strategy":"css","value":"input[id*='telephone_number']","score":100}]},"binding":{"source":"profile","key":"phone"}},
    {"id":"privacy-confirmation","action":"check","target":{"label":"Datenschutzhinweis bestätigt","tag":"input","candidates":[{"strategy":"css","value":"input[id*='gewobag_datenschutzhinweis_bestaetigt']","score":100}]},"binding":{"source":"literal","value":true}},
    {"id":"wbs-document","action":"upload","target":{"label":"WBS inklusive Wohnungsüberlassungsmitteilung","tag":"input","input_type":"file","candidates":[{"strategy":"css","value":"input[type='file']","score":100}]},"binding":{"source":"document","key":"wbs"},"condition":{"mode":"all","conditions":[{"field":"profile.has_wbs","operator":"eq","value":true}]},"optional_target":true,"timeout_seconds":2},
    {"id":"submit-ready","action":"assert","target":{"label":"Anfrage versenden","tag":"button","candidates":[{"strategy":"role","value":"button|Anfrage versenden","score":100}]},"binding":{"source":"literal","value":"Anfrage versenden"}},
    {"id":"submit-application","action":"click","target":{"label":"Anfrage versenden","tag":"button","candidates":[{"strategy":"role","value":"button|Anfrage versenden","score":100}]},"final_submission":true}
  ],
  "email_triggers": []
}
